# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# SSH hardening
awk '$5 >= 3071' /etc/ssh/moduli > /etc/ssh/moduli.safe
mv /etc/ssh/moduli.safe /etc/ssh/moduli

# node-exporter textfile dir is tmpfs; recreate on boot and prime metric shims
mkdir -p /var/prometheus
/usr/bin/qosmate-prom 2>/dev/null || true
/usr/bin/nlbwmon-prom 2>/dev/null || true

# Render client upload-rate-limit nftables chain from /etc/upload-limit.conf
/usr/bin/upload-limit-sync 2>/dev/null || true
