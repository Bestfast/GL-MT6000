#!/bin/sh
# neigh6-hosts - remember which device owns which IPv6 address, and give each
# one a PTR name so AdGuard can label it.
#
# IPv6 clients use SLAAC privacy addresses with random IIDs, and their DHCPv6
# leases carry an empty hostname, so nothing in DNS knows who they are. This
# maps neighbour address -> MAC -> DHCPv4 hostname.
#
# The neighbour table only holds currently-reachable hosts, so a mapping is
# kept in a persistent database for RETENTION_HOURS after it was last seen.
# That is what lets an address AdGuard logged hours ago still resolve.
#
# Names get a "-6" suffix on purpose. A hosts entry creates forward records as
# well as PTR, and attaching a rotating privacy address to the real name would
# hand out AAAA records that die within a day - NPMplus resolves .lan upstreams
# with ipv6=on and would eventually proxy to a dead address.
#
# Run from cron every minute. Rewrites and SIGHUPs dnsmasq only on change.

set -u

DB_DIR=/opt/neigh6
DB=$DB_DIR/db
OUT=/tmp/hosts/neigh6
LEASES=/tmp/dhcp.leases
CONF_GLOB=/var/etc/dnsmasq.conf.*
DOMAIN=lan
RETENTION_HOURS=${RETENTION_HOURS:-48}

# /opt is on the overlay so the database survives a reboot. /tmp is tmpfs and
# may not have the hosts directory yet if cron beats dnsmasq's init script.
mkdir -p "$DB_DIR"
[ -d /tmp/hosts ] || mkdir -p /tmp/hosts

NOW=$(date +%s)
CUTOFF=$((NOW - RETENTION_HOURS * 3600))

MAP=/tmp/.n6map.$$
NEIGH=/tmp/.n6neigh.$$
NEWDB=/tmp/.n6db.$$
NEWOUT=/tmp/.n6out.$$
trap 'rm -f "$MAP" "$NEIGH" "$NEWDB" "$NEWOUT"' EXIT INT TERM

# MAC -> hostname, from active DHCPv4 leases and static dhcp-host entries.
{
	[ -f "$LEASES" ] && awk '$4 != "*" && $4 != "" { print tolower($2), $4 }' "$LEASES"
	for c in $CONF_GLOB; do
		[ -f "$c" ] || continue
		sed -n 's/^dhcp-host=//p' "$c" | awk -F, '
			{
				name = ""
				if (NF == 2) name = $2
				else if (NF >= 3) name = $NF
				# a trailing field of only digits and dots is an IP, not a name
				if (name != "" && name !~ /^[0-9.]+$/) print tolower($1), name
			}'
	done
} > "$MAP"

{ ip -6 neigh show; ip -4 neigh show; } 2>/dev/null > "$NEIGH"

[ -f "$DB" ] || : > "$DB"

# Merge: refresh anything seen right now, keep anything still inside the
# retention window, drop the rest.  DB is TSV: addr, mac, name, last_seen.
awk -v map="$MAP" -v now="$NOW" -v cutoff="$CUTOFF" '
	BEGIN {
		FS = "\t"
		while ((getline line < map) > 0) {
			split(line, f, " ")
			if (!(f[1] in macname)) macname[f[1]] = f[2]   # leases win over static
		}
	}
	# pass 1: existing database
	FILENAME == db_file {
		if ($4 + 0 >= cutoff) { mac[$1] = $2; nm[$1] = $3; seen[$1] = $4 + 0 }
		next
	}
	# pass 2: live neighbour table
	{
		addr = $1
		if (addr ~ /^fe80:/) next            # link-local never reaches the resolver
		m = ""
		for (i = 2; i <= NF; i++) if ($i == "lladdr") m = tolower($(i + 1))
		if (m == "") next                    # FAILED / incomplete entry

		n = (m in macname) ? macname[m] : nm[addr]
		# A device with no DHCP hostname still gets tracked: neigh6-agh-sync
		# needs the MAC-to-address mapping even when there is no name to
		# publish. "-" marks it as unnameable; the hosts file skips those.
		if (n == "") n = "-"

		mac[addr] = m; nm[addr] = n; seen[addr] = now
	}
	END {
		for (a in mac) printf "%s\t%s\t%s\t%d\n", a, mac[a], nm[a], seen[a]
	}
' db_file="$DB" FS='\t' "$DB" FS=' ' "$NEIGH" | sort > "$NEWDB"

if ! cmp -s "$NEWDB" "$DB"; then
	cp "$NEWDB" "$DB"
fi

# Hosts file: IPv6 only. IPv4 already gets PTR from dnsmasq's own leases.
{
	echo "# generated by neigh6-hosts - do not edit"
	awk -F'\t' -v domain="$DOMAIN" '
		$1 ~ /:/ && $3 != "-" {
			n = $3
			sub(/\.$/, "", n)
			sub(/\.lan$/, "", n)
			printf "%s %s-6.%s\n", $1, n, domain
		}' "$DB" | sort -k2
} > "$NEWOUT"

if ! cmp -s "$NEWOUT" "$OUT" 2>/dev/null; then
	cp "$NEWOUT" "$OUT"
	chmod 644 "$OUT"
	killall -HUP dnsmasq 2>/dev/null
	logger -t neigh6-hosts "updated $OUT ($(grep -vc '^#' "$OUT") names, $(wc -l < "$DB") tracked)"
fi
